# ─────────────────────────────────────────────────────────────────────────
# vibe-template — Beispiel-Konfiguration. Kopiere nach .env und passe an.
# ECHTE Secrets gehören NIE ins Repo (.env ist in .gitignore).
#
# Hier steht nur das Minimum: Secrets, was vor der DB gebraucht wird, und
# Schalter pro Prozess. Alles andere (Zeitzone, Login-Methode, OIDC-Anbieter,
# Job-Aufbewahrung …) stellt der Admin in der App ein:
# Admin-Konsole → Einstellungen. Neue Variable? Siehe CLAUDE.md ".env nur minimal".
# ─────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────
PORT=3000
# Pflicht in Produktion (≥ 32 Zeichen): signiert die Session-Cookies.
#   openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# SQLite-Datei (Standard ./app.db) und Log-Datei (Standard ./app.log).
DB_PATH=./app.db
LOG_PATH=./app.log
# Winston-Level: error | warn | info | debug
LOG_LEVEL=info

# ─── Admin (Zugang zur Admin-Konsole) ────────────────────────────────────
# Der eine Admin. Meldet sich immer mit diesem Passwort an — unabhängig von der
# in der Konsole gewählten Login-Methode, also auch, wenn OIDC ausfällt.
# Produktion: Passwort ≥ 16 Zeichen (openssl rand -base64 24).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── OIDC-Secret ─────────────────────────────────────────────────────────
# Nur das Secret steht hier; Issuer, Client-ID und Redirect-URI werden in der
# Admin-Konsole → Einstellungen → Anmeldung gesetzt.
OIDC_CLIENT_SECRET=

# ─── Pro Prozess ─────────────────────────────────────────────────────────
# Cron-Scheduler im Server-Prozess. off z. B. auf einer zweiten Instanz
# derselben DB, damit Jobs nicht doppelt eingereiht werden.
SCHEDULER=on

# ─── Nur lokal ───────────────────────────────────────────────────────────
# LOCAL_DEV_MODE=1 umgeht den Login: jeder Request ist DEV_USER_EMAIL (Admin),
# beim Start werden Seed-Daten angelegt. In Produktion verweigert der Boot.
LOCAL_DEV_MODE=1
DEV_USER_EMAIL=dev@local
