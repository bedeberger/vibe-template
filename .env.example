# ─────────────────────────────────────────────────────────────────────────
# vibe-template — Beispiel-Konfiguration. Kopiere nach .env und passe an.
# ECHTE Secrets gehören NIE ins Repo (.env ist in .gitignore).
# ─────────────────────────────────────────────────────────────────────────

# Server
PORT=3000
# Pflicht in Produktion: zufälliger String, signiert die Session-Cookies.
SESSION_SECRET=change-me-to-a-long-random-string

# Datenbank — Pfad zur SQLite-Datei. Default: ./app.db
DB_PATH=./app.db

# Anzeige-Zeitzone (IANA-Name). Steuert die Frontend-Datumsanzeige.
APP_TIMEZONE=Europe/Zurich

# ─── Auth ────────────────────────────────────────────────────────────────
# LOCAL_DEV_MODE=1 umgeht OIDC komplett: jeder Request gilt als der Dev-User
# (DEV_USER_EMAIL) und beim Start werden Seed-Daten angelegt. NUR lokal!
LOCAL_DEV_MODE=1
DEV_USER_EMAIL=dev@local

# Erster Admin: diese E-Mail bekommt beim Boot global_role='admin'.
ADMIN_EMAIL=dev@local

# OIDC (Produktion). Provider-agnostisch via openid-client (Discovery).
# Beispiel Google: ISSUER=https://accounts.google.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://example.com/auth/callback
